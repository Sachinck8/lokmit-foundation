# =====================================================================
# LOKMIT FOUNDATION - monorepo environment variable reference
# =====================================================================
# This file documents the environment variables used by the project.
# It contains PLACEHOLDER values ONLY - never put real secrets here.
#
# Create your own local copies (gitignored):
#   - backend/.env     -> read by backend/scripts/dev-run.ps1
#   - frontend/.env    -> read by Vite (prefix: VITE_)
#
# ---------------------------------------------------------------------
# Backend (Spring Boot)
# ---------------------------------------------------------------------
# JDBC URL of the PostgreSQL database.
DB_URL=jdbc:postgresql://localhost:5432/lokmit_foundation
# Dedicated application database role (never the postgres superuser).
DB_USERNAME=lokmit_app
# Strong random password for the above role.
DB_PASSWORD=ChangeMe
# HTTP port the backend listens on.
SERVER_PORT=8080
# Secret key for signing JWTs (must be at least 32 bytes for HS256).
JWT_SECRET=ChangeMeWithAtLeast32BytesForHS256Algorithm1234567890
# Access token expiration in milliseconds (default: 900000 = 15 minutes).
JWT_ACCESS_TOKEN_EXPIRATION=900000
# Refresh token expiration in milliseconds (default: 604800000 = 7 days).
JWT_REFRESH_TOKEN_EXPIRATION=604800000
# Bootstrap admin password - only used if admin password_hash is NULL.
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe

# ---------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------
# Base URL of the backend REST API (see frontend/.env.example too).
VITE_API_BASE_URL=/api/v1