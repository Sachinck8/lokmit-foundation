# LOKMIT FOUNDATION backend - local development environment variables.
# Copy this file to ".env" (gitignored) and set real values.
# Never commit real credentials.
DB_URL=jdbc:postgresql://localhost:5432/lokmit_foundation
DB_USERNAME=lokmit_app
DB_PASSWORD=<generated-strong-password>
SERVER_PORT=8080

# JWT Configuration
# Secret key for signing JWTs (must be at least 32 bytes/256 bits for HS256)
JWT_SECRET=<generate-a-strong-random-secret-min-32-bytes>
# Access token expiration in milliseconds (default: 900000 = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRATION=900000
# Refresh token expiration in milliseconds (default: 604800000 = 7 days)
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Bootstrap Admin Configuration
# Set this to initialize the admin password on first startup (only used if password_hash is NULL)
BOOTSTRAP_ADMIN_PASSWORD=<set-a-strong-admin-password>